/* 全局样式：与网页端保持同一套色（深蓝侧栏 + 白卡 + 蓝色主按钮） */
page {
  background: #f4f6f8;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.wrap { padding: 24rpx; }

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(23, 43, 77, .06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #152238;
  margin-bottom: 16rpx;
}

.h1 { font-size: 42rpx; font-weight: 700; color: #152238; }
.sub { font-size: 26rpx; color: #6b7788; margin-top: 6rpx; }

.muted { color: #8b97a8; font-size: 26rpx; }

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}
.row:last-child { border-bottom: none; }
.row .k { color: #6b7788; font-size: 26rpx; }
.row .v { color: #1f2937; font-size: 27rpx; text-align: right; }
.strong { font-weight: 600; }

/* 焦点卡：下一页就诊 */
.focus {
  background: linear-gradient(135deg, #e8f0fe 0%, #f7faff 100%);
  border: 1rpx solid #cfe0f8;
}
.focus .big { font-size: 40rpx; font-weight: 700; color: #152238; }

/* 三格数据 */
.stats { display: flex; gap: 16rpx; }
.stat {
  flex: 1;
  background: #fff;
  border-radius: 18rpx;
  padding: 22rpx 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(23, 43, 77, .05);
}
.stat .n { font-size: 38rpx; font-weight: 700; color: #152238; }
.stat .l { font-size: 23rpx; color: #8b97a8; margin-top: 4rpx; }

/* 按钮 */
.btn {
  display: block;
  text-align: center;
  background: #1d6fd8;
  color: #fff;
  border-radius: 14rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  border: none;
  line-height: 1.2;
}
.btn.ghost {
  background: #fff;
  color: #1d6fd8;
  border: 1rpx solid #b9d4f6;
}
.btn.warn { background: #fff; color: #d94a4a; border: 1rpx solid #f0c2c2; }
.btn[disabled] { background: #c8d4e4; color: #fff; }
.btn-sm {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 10rpx;
  font-size: 25rpx;
  line-height: 1.3;
}
.btn-row { display: flex; gap: 16rpx; margin-top: 8rpx; }
.btn-row .btn { flex: 1; }

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.tag.blue { background: #e8f0fe; color: #1d6fd8; }
.tag.green { background: #e6f6ec; color: #1a7f43; }
.tag.gray { background: #eef1f5; color: #6b7788; }
.tag.red { background: #fdeaea; color: #c93a3a; }
.tag.amber { background: #fef6e2; color: #9a6b00; }

/* 选项行（门店 / 日期 / 时段） */
.opt {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  border: 2rpx solid transparent;
}
.opt.on { border-color: #1d6fd8; background: #f5f9ff; }
.opt .t { font-size: 30rpx; font-weight: 600; color: #152238; }
.opt .s { font-size: 24rpx; color: #6b7788; margin-top: 4rpx; }
.opt.full { opacity: .55; }

/* 日期横滑 */
.days { white-space: nowrap; margin-bottom: 8rpx; }
.day {
  display: inline-block;
  min-width: 118rpx;
  text-align: center;
  padding: 16rpx 10rpx;
  background: #fff;
  border-radius: 14rpx;
  margin-right: 12rpx;
  border: 2rpx solid transparent;
}
.day.on { border-color: #1d6fd8; background: #f5f9ff; }
.day .d { font-size: 27rpx; font-weight: 600; color: #152238; }
.day .w { font-size: 22rpx; color: #6b7788; margin-top: 2rpx; }
.day .r { font-size: 21rpx; color: #1a7f43; margin-top: 2rpx; }
.day .r.zero { color: #b0b8c4; }

/* 空状态 */
.empty {
  text-align: center;
  padding: 56rpx 20rpx;
  color: #8b97a8;
  font-size: 27rpx;
}

/* 表单 */
.field { margin-bottom: 24rpx; }
.field .lab { font-size: 25rpx; color: #6b7788; margin-bottom: 10rpx; }
.field input, .field textarea {
  background: #f7f9fb;
  border: 1rpx solid #e3e9f0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}
.field textarea { height: 140rpx; }

/* 底部固定操作条 */
.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, .96);
  border-top: 1rpx solid #eef1f5;
}
.pad-bottom { padding-bottom: 160rpx; }

/* 提示条 */
.note {
  background: #eef7ee;
  color: #26702f;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 25rpx;
  margin-bottom: 20rpx;
}
.note.warn { background: #fef6e2; color: #8a6100; }
.note.bad { background: #fdeaea; color: #b93b3b; }
